<Window x:Class="GitUploadTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:GitUploadTool.Controls"
        mc:Ignorable="d"
        Title="GitUploadTool" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="#FF1E1E1E">
    <Grid>
        <Border CornerRadius="12" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
            <Grid>
                <!-- 自定义标题栏 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Height="40" Background="#2D2D2D" CornerRadius="12 12 0 0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 标题 -->
                        <TextBlock Grid.Column="0" Text="GitUploadTool" Margin="16 0 0 0" 
                                   VerticalAlignment="Center" FontWeight="Medium" 
                                   Foreground="#FFFFFF" FontSize="14"/>
                        
                        <!-- 窗口控制按钮 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btnMinimize" Content="—" Width="40" Height="40" 
                                    Background="Transparent" BorderBrush="Transparent" 
                                    Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                                    ToolTip="最小化" Click="BtnMinimize_Click"/>
                            <Button x:Name="btnMaximize" Content="□" Width="40" Height="40" 
                                    Background="Transparent" BorderBrush="Transparent" 
                                    Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                    ToolTip="最大化" Click="BtnMaximize_Click"/>
                            <Button x:Name="btnClose" Content="✕" Width="40" Height="40" 
                                    Background="Transparent" BorderBrush="Transparent" 
                                    Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                    ToolTip="关闭" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主内容区 -->
                <Border Grid.Row="1" CornerRadius="0 0 12 12" Background="#1E1E1E">
                    <controls:WebView2Control x:Name="WebViewControl" Margin="0"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
