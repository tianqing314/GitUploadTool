<UserControl x:Class="GitUploadTool.Views.Dialogs.CreateRepoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#0D1117">

    <Border Background="#161B22" CornerRadius="8" Margin="16">
        <StackPanel Margin="24">
            <TextBlock Text="创建新仓库" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

            <TextBlock Text="仓库名称" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4" />
            <TextBox Text="{Binding RepositoryName}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="White" />

            <TextBlock Text="描述（可选）" FontSize="12" Foreground="#8B949E" Margin="0,12,0,4" />
            <TextBox Text="{Binding Description}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="White"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="60" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton Content="公开" IsChecked="{Binding IsPrivate, Converter={StaticResource InverseBoolConverter}}"
                             Foreground="#C9D1D9" Margin="0,0,16,0" />
                <RadioButton Content="私有" IsChecked="{Binding IsPrivate}"
                             Foreground="#C9D1D9" />
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <Button Content="取消" Height="40"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#C9D1D9"
                        HorizontalAlignment="Left"
                        Width="100" />
                <Button Content="创建" Height="40"
                        Command="{Binding OkCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#2EA44F" Foreground="White"
                        HorizontalAlignment="Right"
                        Width="100" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>