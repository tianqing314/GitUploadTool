<UserControl x:Class="GitUploadTool.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#0D1117">

    <Grid VerticalAlignment="Center">
        <Border Background="#161B22" CornerRadius="12" Padding="40" HorizontalAlignment="Center" MaxWidth="500">
            <StackPanel HorizontalAlignment="Center">
                <Viewbox Width="64" Height="64" Margin="0,0,0,16">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#0366D6" Data="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                    </Canvas>
                </Viewbox>

                <TextBlock Text="GitUploadTool" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" FontSize="14" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,16" />
                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#C9D1D9" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                <Separator Background="#21262D" Margin="0,0,0,16" />

                <TextBlock Text="使用说明" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,12" />

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="1. 使用 GitHub 账号登录" FontSize="13" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBlock Text="2. 选择要上传的本地项目文件夹" FontSize="13" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBlock Text="3. 检查 GitHub 仓库是否存在（不存在则自动创建）" FontSize="13" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBlock Text="4. 配置分支和提交信息" FontSize="13" Foreground="#C9D1D9" Margin="0,0,0,6" />
                    <TextBlock Text="5. 点击上传将项目推送到 GitHub" FontSize="13" Foreground="#C9D1D9" />
                </StackPanel>

                <Separator Background="#21262D" Margin="0,0,0,16" />

                <Button Content="在 GitHub 上查看" Height="36"
                        Command="{Binding OpenUrlCommand}"
                        CommandParameter="{Binding GitHubUrl}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#0366D6" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>