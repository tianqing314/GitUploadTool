<UserControl x:Class="GitUploadTool.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#0D1117">

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Step Indicator -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Upload Project" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=0}" />
                                <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="Select" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="#21262D" Height="2" Width="40" VerticalAlignment="Center" />

                        <!-- Step 2 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=1}" />
                                <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="Check" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="3" Background="#21262D" Height="2" Width="40" VerticalAlignment="Center" />

                        <!-- Step 3 -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=2}" />
                                <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="Configure" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Column="5" Background="#21262D" Height="2" Width="40" VerticalAlignment="Center" />

                        <!-- Step 4 -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=3}" />
                                <TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="Upload" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 1: Select Project -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
                <StackPanel>
                    <TextBlock Text="Select Project Folder" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                    
                    <Button Content="📁 Browse Folder"
                            Height="40"
                            Command="{Binding BrowseFolderCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#21262D" Foreground="White"
                            HorizontalAlignment="Left" />

                    <!-- Project Info Card -->
                    <Border Background="#21262D" CornerRadius="6" Padding="16" Margin="0,12,0,0"
                            Visibility="{Binding ProjectPath, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Project Information" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#8B949E" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProjectName}" Foreground="White" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" Foreground="#8B949E" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProjectPath}" Foreground="White" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Files:" Foreground="#8B949E" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileCount}" Foreground="White" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Size:" Foreground="#8B949E" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProjectSize}" Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Next →"
                            Height="40" Margin="0,16,0,0"
                            Command="{Binding NextStepCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0366D6" Foreground="White"
                            HorizontalAlignment="Right"
                            IsEnabled="{Binding ProjectPath, Converter={StaticResource NullToBoolConverter}}" />
                </StackPanel>
            </Border>

            <!-- Step 2: Check Repository -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
                <StackPanel>
                    <TextBlock Text="Check GitHub Repository" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                    
                    <Button Content="🔍 Check Repository"
                            Height="40"
                            Command="{Binding CheckRepoCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#21262D" Foreground="White"
                            HorizontalAlignment="Left" />

                    <!-- Repository Status -->
                    <Border Background="#21262D" CornerRadius="6" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#8B949E" />
                            
                            <!-- Repository Found -->
                            <Border Background="#0D1117" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                                    Visibility="{Binding RepoExistsOnGithub, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="✅ Repository exists" FontSize="14" Foreground="#56D364" />
                                    <TextBlock>
                                        <Hyperlink NavigateUri="{Binding ExistingRepo.HtmlUrl}"
                                                   Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding ExistingRepo.HtmlUrl}">
                                            <TextBlock Text="{Binding ExistingRepo.FullName}" FontSize="13" Foreground="#0366D6" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Repository Not Found -->
                            <StackPanel Visibility="{Binding RepoExistsOnGithub, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="❌ Repository not found" FontSize="14" Foreground="#F85149" Margin="0,8,0,0" />
                                <Button Content="➕ Create Repository"
                                        Height="36" Margin="0,8,0,0"
                                        Command="{Binding CreateRepoCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#2EA44F" Foreground="White"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Button Content="← Back" Height="40"
                                Command="{Binding PreviousStepCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C9D1D9"
                                HorizontalAlignment="Left" />
                        <Button Content="Next →" Height="40"
                                Command="{Binding NextStepCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#0366D6" Foreground="White"
                                HorizontalAlignment="Right"
                                IsEnabled="{Binding RepoExistsOnGithub}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 3: Configure -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
                <StackPanel>
                    <TextBlock Text="Configure Upload" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Branch" FontSize="13" Foreground="#8B949E" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedBranch}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" />

                            <TextBlock Text="Commit Message" FontSize="13" Foreground="#8B949E" Margin="0,12,0,4" />
                            <TextBox Text="{Binding CommitMessage}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80" />
                        </StackPanel>

                        <!-- Right Column -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text=".gitignore Template" FontSize="13" Foreground="#8B949E" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding GitIgnoreTemplates}"
                                      SelectedItem="{Binding SelectedGitIgnore}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Foreground="White" />

                            <TextBlock Text="Preview" FontSize="13" Foreground="#8B949E" Margin="0,12,0,4" />
                            <Border Background="#0D1117" CornerRadius="4" Padding="8" Height="100">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedTemplate.Content}"
                                               FontSize="11" Foreground="#8B949E"
                                               FontFamily="Consolas" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Button Content="← Back" Height="40"
                                Command="{Binding PreviousStepCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C9D1D9"
                                HorizontalAlignment="Left" />
                        <Button Content="Next →" Height="40"
                                Command="{Binding NextStepCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#0366D6" Foreground="White"
                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 4: Upload -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
                <StackPanel>
                    <TextBlock Text="Upload Project" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />
                    
                    <Button Content="🚀 Start Upload"
                            Height="48" FontSize="16"
                            Command="{Binding UploadCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#2EA44F" Foreground="White"
                            IsEnabled="{Binding IsUploading, Converter={StaticResource InverseBoolConverter}}"
                            HorizontalAlignment="Stretch" />

                    <!-- Progress -->
                    <ProgressBar IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="#0366D6"
                                 Margin="0,16,0,0" />

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="14" Foreground="#8B949E"
                               Margin="0,12,0,0" />

                    <!-- Log Output -->
                    <Border Background="#0D1117" CornerRadius="6" Padding="12" Margin="0,12,0,0" Height="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UploadProgress}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}[{0:HH:mm:ss}]'}"
                                                       FontSize="12" Foreground="#484F58" FontFamily="Consolas" />
                                            <TextBlock FontSize="12" FontFamily="Consolas" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8B949E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                <Setter Property="Foreground" Value="#56D364" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="#F85149" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="Foreground" Value="#0366D6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                        <Binding Path="Step" />
                                                        <Binding Path="Message" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Content="← Back" Height="40" Margin="0,16,0,0"
                            Command="{Binding PreviousStepCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#C9D1D9"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <!-- Create Repository Dialog Overlay -->
    <Border Background="#80000000"
            Visibility="{Binding ShowCreateRepoDialog, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="#161B22" CornerRadius="12" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="400">
            <StackPanel>
                <TextBlock Text="Create New Repository" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

                <TextBlock Text="Repository Name" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4" />
                <TextBox x:Name="RepoNameBox"
                         Text="{Binding ProjectName}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White" />

                <TextBlock Text="Description (optional)" FontSize="12" Foreground="#8B949E" Margin="0,12,0,4" />
                <TextBox x:Name="RepoDescBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White" />

                <CheckBox x:Name="PrivateCheck"
                          Content="Make repository private"
                          Foreground="#C9D1D9" Margin="0,12,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel"
                            Height="36" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#C9D1D9"
                            Click="CancelCreateRepo_Click" />
                    <Button Content="Create"
                            Height="36"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#2EA44F" Foreground="White"
                            Click="ConfirmCreateRepo_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
