<UserControl x:Class="GitUploadTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#0D1117">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,16" />

            <!-- Proxy Settings -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🌐 代理设置" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                    <TextBlock Text="配置网络连接的 HTTP 代理" FontSize="12" Foreground="#8B949E" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="代理地址" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ProxyAddress}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     md:HintAssist.Hint="例如：http://proxy.example.com" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="端口" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ProxyPort}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White"
                                     md:HintAssist.Hint="例如：8080" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Default Settings -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⚙️ 默认设置" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="默认分支" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DefaultBranch}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="默认提交信息" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DefaultCommitMessage}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Token Management -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🔑 令牌管理" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16" />
                    
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CheckCircle" Foreground="#56D364" VerticalAlignment="Center"
                                     Visibility="{Binding HasToken, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <md:PackIcon Kind="AlertCircle" Foreground="#F85149" VerticalAlignment="Center"
                                     Visibility="{Binding HasToken, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="令牌已配置" />
                                    <Setter Property="Foreground" Value="#56D364" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasToken}" Value="False">
                                            <Setter Property="Text" Value="未配置令牌" />
                                            <Setter Property="Foreground" Value="#F85149" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Content="🗑️ 清除令牌"
                            Height="36" Margin="0,12,0,0"
                            Command="{Binding ClearTokenCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#F85149"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding HasToken}" />
                </StackPanel>
            </Border>

            <!-- .gitignore Templates -->
            <Border Background="#161B22" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📄 .gitignore 模板" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                    <TextBlock Text="适用于不同项目类型的模板" FontSize="12" Foreground="#8B949E" Margin="0,0,0,16" />
                    
                    <ListView ItemsSource="{Binding GitIgnoreTemplates}"
                              Background="Transparent"
                              BorderThickness="0"
                              Height="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#21262D" CornerRadius="4" Padding="12" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding Language}" FontSize="12" Foreground="#8B949E" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button Content="💾 保存设置"
                    Height="44" FontSize="15"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0366D6" Foreground="White"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
