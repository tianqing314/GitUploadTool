<Window x:Class="GitUploadTool.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="GitUploadTool - 登录"
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">
    
   <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1117" Offset="0" />
                <GradientStop Color="#161B22" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="340" Height="420"
                Background="#21262D"
                CornerRadius="12"
                Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black" />
            </Border.Effect>

           <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
               <!-- GitHub Logo -->
               <Viewbox Width="80" Height="80" Margin="0,0,0,20">
                   <Canvas Width="24" Height="24">
                       <Path Fill="White" Data="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                   </Canvas>
               </Viewbox>

               <!-- Title -->
               <TextBlock Text="GitUploadTool"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,8" />

               <TextBlock Text="将您的项目上传到 GitHub"
                          FontSize="13"
                          Foreground="#8B949E"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20" />

               <!-- Token Input -->
               <TextBlock Text="GitHub 个人访问令牌"
                          FontSize="12"
                          Foreground="#8B949E"
                          Margin="0,0,0,8" />
               <TextBox x:Name="TokenTextBox"
                        Height="40"
                        FontSize="13"
                        Padding="12,8"
                        Background="#0D1117"
                        Foreground="White"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        Margin="0,0,0,8"
                        AcceptsReturn="False" />

               <!-- Help Link -->
               <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16">
                   <Hyperlink Foreground="#0366D6" Command="{Binding OpenHelpCommand}">
                       <TextBlock Text="如何获取令牌？" FontSize="11" />
                   </Hyperlink>
               </TextBlock>

               <!-- Login Button -->
               <Button Content="登录"
                       Height="44"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Command="{Binding LoginCommand}"
                       CommandParameter="{Binding ElementName=TokenTextBox, Path=Text}"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Background="#0366D6"
                       Margin="0,0,0,16">
                   <Button.Effect>
                       <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#0366D6" />
                   </Button.Effect>
               </Button>

               <!-- Loading Indicator -->
               <md:PackIcon Kind="Loading" Width="32" Height="32"
                            Foreground="#0366D6"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

               <!-- Status Message -->
               <TextBlock Text="{Binding StatusMessage}"
                          FontSize="12"
                          Foreground="#F85149"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          Margin="0,8,0,0" />

               <!-- Footer -->
               <TextBlock Text="v1.0.0"
                          FontSize="11"
                          Foreground="#484F58"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0" />
           </StackPanel>
        </Border>
    </Grid>
</Window>
